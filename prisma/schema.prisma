generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectKind {
  SOLO
  TEAM
}

model Project {
  id             String      @id @default(cuid())
  slug           String      @unique
  title          String
  tagline        String
  kind           ProjectKind
  myRole         String?
  stack          String[]
  repoUrl        String?
  liveUrl        String?
  coverImage     String?
  order          Int
  published      Boolean     @default(false)
  summary        String
  reasoning      String
  technicalDepth String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([published, order])
}
